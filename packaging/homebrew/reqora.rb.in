# Homebrew cask for Reqora. This is a template: packaging/homebrew/render-cask.sh fills in
# the version, the checksum and the repository, and CI publishes the result to the tap.
cask "reqora" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@REPOSITORY@/releases/download/v#{version}/reqora_#{version}_macos_universal.dmg"
  name "Reqora"
  desc "Fast, lightweight API client (a Postman alternative)"
  homepage "https://github.com/@REPOSITORY@"

  livecheck do
    url :url
    strategy :github_latest
  end

  app "Reqora.app"

  zap trash: "~/Library/Application Support/Reqora"

  caveats <<~EOS
    Reqora is not notarized by Apple yet, so macOS blocks the first launch:
      1. Open Reqora once and close the warning.
      2. System Settings → Privacy & Security → "Open Anyway" next to Reqora.
    After that it opens normally, including after updates.
  EOS
end
