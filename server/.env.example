# Copy to .env and fill in. Used by docker-compose.yml.

# Domain the server is reachable at; its DNS A/AAAA record must point to this machine.
REQORA_DOMAIN=sync.example.com

# Database password. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signing up needs an invite code, created on the server with:
#   docker compose exec server python -m reqora_server.admin create-invite --email someone@example.com
# true lets anyone who can reach the server sign up. Keep it false on the internet.
REQORA_OPEN_REGISTRATION=false
